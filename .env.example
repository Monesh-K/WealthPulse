PORT=3000
NODE_ENV=production
DB_PATH=./data/wealthpulse.db

# ─── Authentication (Google OAuth) ───────────────
# Get your Google Client ID at: https://console.cloud.google.com/apis/credentials
# Leave blank to run without authentication (local mode)
GOOGLE_CLIENT_ID=
JWT_SECRET=change_this_to_a_random_secret

# ─── AI (Groq — FREE) ───────────────────────────
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Cloud Backup (GitHub Gist — FREE) ──────────
# Ensures your data survives Render free-tier restarts/redeploys.
# 1. Create a GitHub Personal Access Token at: https://github.com/settings/tokens
#    → Select scope: "gist" (nothing else needed)
# 2. Create a secret Gist at: https://gist.github.com
#    → Filename: wealthpulse-backup.json  |  Content: {}
#    → Copy the Gist ID from the URL (e.g., https://gist.github.com/you/abc123 → abc123)
GITHUB_TOKEN=
GIST_ID=
